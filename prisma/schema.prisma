generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?
  image         String?
  role          String    @default("user") // user, admin
  plan          String    @default("free") // free, pro, business
  clipsUsed     Int       @default(0)
  clipsLimit    Int       @default(5)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  videos        Video[]
  templates     Template[]
}

model Video {
  id            String    @id @default(cuid())
  userId        String
  sourceUrl     String
  title         String?
  thumbnailUrl  String?
  duration      String?
  status        String    @default("processing") // processing, completed, failed
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clips         Clip[]
}

model Clip {
  id               String    @id @default(cuid())
  videoId          String
  title            String
  startTime        String    @default("0:00")
  duration         String    @default("0:30")
  viralityScore    Int       @default(0)
  captions         String?   // JSON string of caption segments
  captionStyle     String    @default("default") // default, bold, karaoke, outline
  captionFont      String    @default("inter") // font family for captions
  captionAnimation String    @default("none") // animation type for captions
  captionColor     String    @default("#ffffff") // caption text color
  captionSize      Int       @default(24) // caption font size in px
  captionPosition  String    @default("bottom") // bottom, center, top
  layout           String    @default("9:16") // 9:16, 1:1, 16:9
  templateId       String?
  tags             String    @default("[]") // JSON array of tags
  isPublished      Boolean   @default(false)
  publishedTo      String    @default("[]") // JSON array of platforms
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  video            Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  template         Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
}

model Template {
  id            String    @id @default(cuid())
  userId        String?
  name          String
  description   String?
  colors        String    @default("{}") // JSON: { primary, secondary, bg, text }
  font          String    @default("Inter")
  logoPosition  String    @default("bottom-right")
  captionStyle  String    @default("default")
  layout        String    @default("9:16")
  isDefault     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clips         Clip[]
}
